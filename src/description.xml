<?xml version="1.0" encoding="UTF-8"?>
<!--
  description.xml - Metadati dell'estensione LibreOffice (.oxt)
  L'identificatore deve essere univoco e coerente con:
    - ProtocolHandler.xcu (registrazione del protocollo)
    - il lookup PackageInformationProvider nel codice Python (per trovare il modello Vosk)
-->
<description xmlns="http://openoffice.org/extensions/description/2006"
             xmlns:xlink="http://www.w3.org/1999/xlink"
             xmlns:lo="http://libreoffice.org/extensions/description/2011">

  <!-- ID univoco del pacchetto. Usato a runtime per localizzare la cartella dell'estensione. -->
  <identifier value="org.libreitalia.dettaturavocale"/>

  <!-- Versione dell'estensione (semver). -->
  <version value="0.1.0"/>

  <!-- Versione minima di LibreOffice (Python 3 + pyuno moderni).
       NB: usare l'elemento LibreOffice-minimal-version, NON
       OpenOffice.org-minimal-version: quest'ultimo in LibreOffice e' bloccato
       alla compatibilita' OOo 4.1, quindi un valore 7.0 non e' mai soddisfatto
       e l'installazione viene rifiutata. -->
  <dependencies>
    <lo:LibreOffice-minimal-version lo:name="LibreOffice 7.0" value="7.0"/>
  </dependencies>

  <!-- Piattaforme supportate. Vosk/sounddevice sono binari nativi: dichiarare le piattaforme
       per cui si distribuiscono effettivamente i .so/.dll bundlati. "all" e' ammesso solo se
       si includono i binari per ogni OS (vedi docs/ARCHITETTURA.md). -->
  <platform value="@PLATFORM@"/>

  <display-name>
    <name lang="it">Dettatura Vocale (Vosk - @MODEL_LANG_IT@)</name>
    <name lang="en">Voice Dictation (Vosk - @MODEL_LANG_EN@)</name>
  </display-name>

  <publisher>
    <name xlink:href="https://github.com/deh-aleh/dettatura-vocale-libreoffice"
          lang="it">Progetto Dettatura Vocale</name>
  </publisher>

  <extension-description>
    <src xlink:href="descriptions/desc_it.txt" lang="it"/>
    <src xlink:href="descriptions/desc_en.txt" lang="en"/>
  </extension-description>

  <icon>
    <default xlink:href="icons/extension_icon.png"/>
  </icon>

</description>
