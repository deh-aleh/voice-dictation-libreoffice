<?xml version="1.0" encoding="UTF-8"?>
<!--
  Addons.xcu - Aggiunge un pulsante alla toolbar di LibreOffice Writer.

  - Il pulsante invia il comando URL "vnd.libreitalia.dettatura:toggle".
  - Quel protocollo e' intercettato da ProtocolHandler.xcu -> dettatura.py.
  - OfficeToolBar inserisce l'elemento nella UI.

  Per limitare il pulsante al solo Writer si usa il contesto del modulo
  com.sun.star.text.TextDocument.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons"
                    oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">

    <!-- Voce di menu sempre visibile (fallback se la toolbar e' nascosta).
         Aggiunge un menu "Dettatura" nella barra dei menu di Writer. -->
    <node oor:name="OfficeMenuBar">
      <node oor:name="org.libreitalia.dettaturavocale.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="it">Dettatura</value>
          <value xml:lang="en">Dictation</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.text.TextDocument</value>
        </prop>
        <node oor:name="Submenu">
          <node oor:name="m1" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string">
              <value>vnd.libreitalia.dettatura:toggle</value>
            </prop>
            <prop oor:name="Title" oor:type="xs:string">
              <value xml:lang="it">Inizia/Ferma Dettatura</value>
              <value xml:lang="en">Start/Stop Dictation</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
            <prop oor:name="Context" oor:type="xs:string">
              <value>com.sun.star.text.TextDocument</value>
            </prop>
          </node>
        </node>
      </node>
    </node>

    <!-- Pulsante nella barra degli strumenti. -->
    <node oor:name="OfficeToolBar">
      <node oor:name="org.libreitalia.dettaturavocale.toolbar" oor:op="replace">
        <node oor:name="m1" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>vnd.libreitalia.dettatura:toggle</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value xml:lang="it">Inizia/Ferma Dettatura</value>
            <value xml:lang="en">Start/Stop Dictation</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string">
            <value>_self</value>
          </prop>
          <prop oor:name="Context" oor:type="xs:string">
            <value>com.sun.star.text.TextDocument</value>
          </prop>
        </node>
      </node>
    </node>

    <!-- Associazione comando -> icone (16px normale, 26px high-contrast/HiDPI). -->
    <node oor:name="Images">
      <node oor:name="org.libreitalia.dettaturavocale.image.toggle" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>vnd.libreitalia.dettatura:toggle</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>%origin%/icons/mic_16.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/icons/mic_26.png</value>
          </prop>
        </node>
      </node>
    </node>

  </node>
</oor:component-data>
